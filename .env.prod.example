PUBLIC_DOMAIN=bot.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=curator_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=curator_db
REDIS_PASSWORD=replace_with_a_different_long_random_password

TG_DB_USERNAME=curator_tg
TG_DB_PASSWORD=replace_with_a_unique_tg_database_password
VK_DB_USERNAME=curator_vk
VK_DB_PASSWORD=replace_with_a_unique_vk_database_password
ORCHESTRATOR_DB_USERNAME=curator_orchestrator
ORCHESTRATOR_DB_PASSWORD=replace_with_a_unique_orchestrator_database_password
AI_DB_USERNAME=curator_ai
AI_DB_PASSWORD=replace_with_a_unique_ai_database_password

TELEGRAM_BOT_NAME=your_curator_bot
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_BOT_NAME=your_admin_bot
TELEGRAM_ADMIN_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_MINI_APP_URL=https://replace-me.example
MINI_APP_ALLOWED_ORIGIN=https://replace-me.example
MINI_APP_INIT_DATA_MAX_AGE=10m

OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openai/gpt-5.4-mini
APP_SECRET_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

VK_API_VERSION=5.199
TELEGRAM_STARS_PRODUCT_PAYLOAD=pro-350-stars-v1
TELEGRAM_STARS_PRO_PRICE=350
TELEGRAM_STARS_PRO_CREDITS=300000

BILLING_CREDITS_PER_USD=200000
BILLING_MINIMUM_CHARGE=100
BILLING_RESERVATION_CREDITS=1000
BILLING_RESERVATION_TTL=24h

APP_LOG_LEVEL=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_grafana_password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
ALERTMANAGER_RETENTION=120h
ALERTMANAGER_SECRETS_DIR=.secrets/alertmanager
